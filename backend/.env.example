# Finnhub API key (recommended) - quotes, company names, company news
# Free key at https://finnhub.io/register (60 calls/min, US stocks)
FINNHUB_API_KEY=your_finnhub_key_here

# News API key (fallback for /news if FINNHUB_API_KEY is not set)
# Note: NewsAPI's free plan does NOT work on deployed servers (HTTP 426)
# NEWS_API_KEY=your_newsapi_key_here

# Optional - defaults to https://newsapi.org/v2/everything
# NEWS_URL=https://newsapi.org/v2/everything

# Comma-separated allowed frontend origins
# CORS_ORIGINS=https://stock-view-ebon.vercel.app,http://localhost:5173

# Cache TTL in seconds
# MODEL_CACHE_TTL_SECONDS=3600
# DATA_CACHE_TTL_SECONDS=300

# Optional Redis connection (survives Render restarts)
# Free serverless Redis at https://upstash.com/
# REDIS_URL=rediss://default:your_token@your-endpoint.upstash.io:6379

# --- Upstream request limits (all optional; defaults shown) ---
# Network timeout passed to yfinance, and the wall-clock limit a request waits for it.
# YF_NETWORK_TIMEOUT_SECONDS=10
# YF_DEADLINE_SECONDS=15
# Optional lookups on /price (volume, company name) wait at most this long.
# BEST_EFFORT_DEADLINE_SECONDS=3
# Yahoo worker threads, and max yfinance calls running or still finishing at once.
# YF_MAX_WORKERS=4
# YF_MAX_PENDING=8
# How long a failed upstream call is remembered before retrying.
# FAILURE_CACHE_TTL_SECONDS=30
# NAME_FAILURE_TTL_SECONDS=300
# FINNHUB_TIMEOUT_SECONDS=5
